{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Bash(cat .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(less .env*)",
      "Bash(more .env*)",
      "Bash(grep * .env*)",
      "Bash(source .env*)",
      "Bash(printenv*)",
      "Bash(env)",
      "PowerShell(Get-Content .env*)",
      "PowerShell(gc .env*)",
      "PowerShell(cat .env*)",
      "PowerShell(type .env*)"
    ]
  }
}
